unit rttiAttributes;  {$mode objfpc}{$H+} {$modeswitch prefixedattributes}  interface  uses Classes, SysUtils, Controls, StdCtrls, Rtti;  type FormFieldAttribute = class(TCustomAttribute) private FFieldName: string; FRequired: Boolean; public constructor Create(const AFieldName: string; ARequired: Boolean = False); property FieldName: string read FFieldName; property Required: Boolean read FRequired; end;  TCustomerForm = class(TForm) published [FormField('customer_name', True)] edtName: TEdit;  [FormField('customer_notes', False)] edtNotes: TEdit; public procedure ClearAnnotatedFields; end;  implementation  constructor FormFieldAttribute.Create(const AFieldName: string; ARequired: Boolean); begin FFieldName := AFieldName; FRequired := ARequired; end;  procedure TCustomerForm.ClearAnnotatedFields; var Ctx: TRttiContext; Field: TRttiField; Attr: TCustomAttribute; Ctrl: TObject; begin Ctx := TRttiContext.Create; try for Field in Ctx.GetType(Self.ClassType).GetFields do for Attr in Field.GetAttributes do if Attr is FormFieldAttribute then begin Ctrl := Field.GetValue(Self).AsObject; if Ctrl is TCustomEdit then TCustomEdit(Ctrl).Clear; end; finally Ctx.Free; end; end;  end.