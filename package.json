{
  "name": "prettier-plugin-pascal",
  "version": "0.1.0",
  "description": "A modern, opinionated Prettier plugin that automatically formats Pascal code—including Delphi, Object Pascal, Free Pascal, and Lazarus—with fast, consistent, and reliable styling for a seamless development experience.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:parser": "node scripts/download-parser.mjs",
    "build:ts": "tsup src/index.ts",
    "build": "npm run clean && npm run build:ts && npm run build:parser",
    "clean": "rimraf dist"
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "formatter",
    "code-formatter",
    "pascal",
    "object-pascal",
    "delphi",
    "freepascal",
    "fpc",
    "lazarus",
    "source-code",
    "code-style",
    "formatting",
    "developer-tools"
  ],
  "author": "Rio Sanjaya",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "copyfiles": "^2.4.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "web-tree-sitter": "0.26.11"
  }
}
